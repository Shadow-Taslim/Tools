# Server configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Temporary Email Service Configuration
# Set to your custom disposable domain pointing MX records to your inbound mail provider
EMAIL_INBOUND_DOMAIN="temp.vortextools.org"
EMAIL_WEBHOOK_SECRET="vortex_webhook_secret_key_123"

# Database & Storage (MERN Stack: MongoDB connection)
# Set to your MongoDB connection string (e.g. MongoDB Atlas or local MongoDB instance)
# If omitted or offline, the server runs with an automatic memory store so dev never breaks
MONGODB_URI="mongodb://localhost:27017/quicknest"

# Anti-Abuse & URL Scanner API Key (Optional, built-in blocklist and heuristic scanner active by default)
SAFE_BROWSING_API_KEY=""

