# Server configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Temporary Email Service Configuration
# Set to your custom disposable domain pointing MX records to your inbound mail provider
EMAIL_INBOUND_DOMAIN="temp.vortextools.org"
EMAIL_WEBHOOK_SECRET="vortex_webhook_secret_key_123"

# Database & Cache (Optional in local preview, falls back to embedded zero-config store)
DATABASE_URL="postgres://postgres:password@localhost:5432/vortextools"
REDIS_URL="redis://localhost:6379"

# Anti-Abuse & URL Scanner API Key (Optional, built-in blocklist and heuristic scanner active by default)
SAFE_BROWSING_API_KEY=""

